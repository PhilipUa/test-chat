PORT=3000
MYSQL_URL=mysql://root:root@mysql:3306/relay?charset=utf8mb4
MONGO_URL=mongodb://mongo:27017/relay
REDIS_URL=redis://redis:6379

# Key for the message-body HMAC. Fine to leave as-is locally; must be a real secret in a
# deployment, since it's what makes the signature forgery-resistant.
MESSAGE_SIGNING_KEY=relay-dev-signing-key-do-not-ship

# Rate limiting — tasks/rate-limiting.md — now lives in rate-limit.config.json, which documents every
# bucket and is bind-mounted into the container, so editing it plus `docker compose restart api` is the
# retune loop. The variables below still work and still win over the file; they are commented out
# because a value set here silently shadows the file, and someone editing the file and seeing nothing
# change is exactly the confusion worth avoiding. Uncomment to override one rule for this deployment.
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=10000
# SEARCH_RATE_LIMIT_MAX=20
# READ_RATE_LIMIT_MAX=100
# CREATE_RATE_LIMIT_MAX=60
# TYPING_RATE_LIMIT_MAX=10
# RATE_LIMIT_CONFIG=rate-limit.config.json

# Page size for GET /api/messages.
MESSAGES_PAGE_SIZE=50

# Page size for GET /api/conversations. The client refetches the inbox on every reconnect, so this
# is a bound on that, not just a display choice.
CONVERSATIONS_PAGE_SIZE=50
