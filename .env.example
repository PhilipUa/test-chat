PORT=3000
MYSQL_URL=mysql://root:root@mysql:3306/relay?charset=utf8mb4
MONGO_URL=mongodb://mongo:27017/relay?replicaSet=rs0
REDIS_URL=redis://redis:6379

# Key for the message-body HMAC. Fine to leave as-is locally; must be a real secret in a
# deployment, since it's what makes the signature forgery-resistant.
MESSAGE_SIGNING_KEY=relay-dev-signing-key-do-not-ship

# Rate limiting — tasks/rate-limiting.md. Defaults live in code (src/config/rate-limit-rules.ts,
# next to what each bucket meters); the variables below are the per-deployment override. Commented
# out so the shipped defaults visibly apply; uncomment to retune one rule for this deployment.
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=10000
# SEARCH_RATE_LIMIT_MAX=20
# READ_RATE_LIMIT_MAX=100
# CREATE_RATE_LIMIT_MAX=60
# TYPING_RATE_LIMIT_MAX=10

# Page size for GET /api/messages.
MESSAGES_PAGE_SIZE=50

# Page size for GET /api/conversations. The client refetches the inbox on every reconnect, so this
# is a bound on that, not just a display choice.
CONVERSATIONS_PAGE_SIZE=50
